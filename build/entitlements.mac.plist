<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron itself needs these under Hardened Runtime to run at all. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Sites the user grants camera/mic/location permission to (see
       permission-manager.js) need these to actually reach the hardware
       under Hardened Runtime; without them the OS silently denies the
       request no matter what the user clicked. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!-- WebAuthn platform authenticator (Touch ID passkeys) stores/retrieves
       credentials via the Secure Enclave through Keychain; this is what
       that access is scoped to. electron-builder signs via a raw codesign
       call, not through Xcode's build system, so the $(AppIdentifierPrefix)
       variable is never substituted; the real Team ID must be hardcoded
       here instead. -->
  <key>com.apple.security.keychain-access-groups</key>
  <array>
    <string>PP84FD7UBN.com.imators.mibrowser</string>
  </array>
</dict>
</plist>
