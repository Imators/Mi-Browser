{
  "name": "mi-browser",
  "version": "1.2.0",
  "author": "Imators LLC",
  "license": "MIT",
  "main": "src/main/main.js",
  "homepage": "./",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:css": "tailwindcss -i ./src/renderer/tailwind.css -o ./src/assets/css/tailwind.css --minify",
    "start": "npm run build:css && electron .",
    "build": "npm run build:css && electron-builder",
    "build:mac": "npm run build:css && electron-builder --mac",
    "build:win": "npm run build:css && electron-builder --win",
    "build:linux": "npm run build:css && electron-builder --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.imators.mibrowser",
    "productName": "Mi Browser",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "icon": "src/assets/icons/icon.png",
    "protocols": [
      {
        "name": "Web link",
        "schemes": ["http", "https"]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.web-browser",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "plist": "^3.1.0"
  }
}
